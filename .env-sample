CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
UPLOAD_DIR=./backend/uploads
CHROMA_PATH=./backend/chroma_db
USER_DB_PATH=./backend/users.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Mandatory Auth Configuration
## following secret can be generated from following command: openssl rand -base64 32
JWT_SECRET=your_super_secret_key_here
HR_EMAIL=<email-id-of-HR-user>
HR_INITIAL_PW=<initial-password-for-HR-user>

# LLM Provider Configuration ('ollama' or 'groq')
LLM_PROVIDER=ollama

# Ollama Specific Settings
OLLAMA_MODEL=qwen2.5:7b

# Groq Specific Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Evaluation suite only (python -m evaluation.run_suite)
## key from a separate Groq account so evaluation never spends the app's quota
EVAL_GROQ_API_KEY=your_eval_groq_api_key_here
EVAL_JUDGE_MODEL=openai/gpt-oss-120b
EVAL_JUDGE_MAX_TOKENS=2048
## eval asks for ~N-word answers to save tokens; 0 = no limit
EVAL_ANSWER_MAX_WORDS=100
